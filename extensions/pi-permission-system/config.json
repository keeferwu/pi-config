{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": true,
  "doublePressToConfirm": false,
  "commandEffects": {
    "du": { "effects": "read" },
    "df": { "effects": "read" },
    "git": {
      "unlessOption": ["--output"],
      "subcommands": {
        "log": "read",
        "show": "read",
        "status": "read",
        "diff": "read",
        "rev-parse": "read",
        "remote": "read",
        "blame": "read",
        "grep": "read",
        "describe": "read",
        "shortlog": "read",
        "ls-files": "read",
        "ls-tree": "read"
      }
    },
    "rtk": {
      "subcommands": {
        "ls": "read",
        "tree": "read",
        "read": "read",
        "find": "read",
        "grep": "read",
        "rg": "read",
        "ast-grep": "read",
        "diff": "read",
        "log": "read",
        "wc": "read",
        "json": "read",
        "deps": "read",
        "env": "read",
        "du": "read",
        "df": "read",
        "gain": "read",
        "recall": "read",
        "git": {
          "unlessOption": ["--output"],
          "subcommands": {
            "log": "read",
            "show": "read",
            "status": "read",
            "diff": "read",
            "rev-parse": "read",
            "remote": "read",
            "blame": "read",
            "grep": "read",
            "describe": "read",
            "shortlog": "read",
            "ls-files": "read",
            "ls-tree": "read"
          }
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "~/.ssh/**": "deny"
    },
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf /": "deny",
      "rm -rf --no-preserve-root*": "deny",
      "rm -rf ~": "deny",
      "rm -rf /tmp/*": "allow",
      "rm -fr /tmp/*": "allow",
      "rm -r /tmp/*": "allow",
      "rm -f /tmp/*": "allow",
      "rm /tmp/*": "allow",
      "rm */node_modules*": "allow",
      "rm */.venv*": "allow",
      "rm */__pycache__*": "allow",
      "rm */dist*": "allow",
      "rm */build*": "allow",
      "rm */target*": "allow",
      "rm *.log*": "allow",
      "dd *": "ask",
      "mkfs*": "ask",
      "shutdown*": "deny",
      "reboot*": "deny",
      "git push --force*": "deny",
      "rtk git push --force*": "deny",
      "git push -f*": "deny",
      "rtk git push -f*": "deny",
      "git reset --hard *": "ask",
      "git clean *": "ask",
      "git branch -D*": "ask",
      "rtk git branch -D*": "ask",
      "rtk run *": "ask",
      "rtk bypass *": "ask",
      "rtk err *": "ask",
      "rtk test *": "ask",
      "rtk summary *": "ask"
    }
  }
}
